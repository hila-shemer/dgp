{
  "manifest_version": 3,
  "name": "DGP fill",
  "version": "0.1.0",
  "description": "Fill a DGP-derived password into the current page, via the local dgp native host.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "scripting"],
  "action": {
    "default_title": "DGP fill",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Open the DGP fill popup"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
